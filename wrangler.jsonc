// Cloudflare Workers – the site is served as static files straight from this repository. worker.js only locks /admin/ and serves /cfg.json.
// Cloudflare builds it on every push to main (Workers Builds); the Worker in the dashboard must be named exactly like "name".
{
  "name": "financial-calculator",
  "main": "worker.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": ".",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/admin", "/admin/*", "/cfg.json"]
  }
}
