# Environment example
# Copy to .env and fill in the values before running the server.

PORT=3000
SESSION_SECRET=replace_with_a_secure_random_string
ADMIN_PASSWORD=admin123

# GitHub repository settings for committing edits
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=ysdesign-il
GITHUB_REPO=financial-calculator
GITHUB_BRANCH=main

# Optional AI integration
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
